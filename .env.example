# USAP Environment Configuration

# Database (SQLite for local dev, PostgreSQL for production)
# Local: file:./dev.db
# Production: postgresql://user:password@host:5432/usap
DATABASE_URL=file:./dev.db

# Server
PORT=3001
JWT_SECRET=CHANGE-THIS-IN-PRODUCTION
NODE_ENV=development

# Frontend
VITE_APP_NAME=USAP
VITE_APP_VERSION=1.0.0
VITE_API_URL=
VITE_ENCRYPTION_KEY=CHANGE-THIS-IN-PRODUCTION
